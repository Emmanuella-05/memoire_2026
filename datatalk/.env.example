# Claude API
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
anthropic-workspace-id=

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=datatalk

# Runtime workspace (defaults to ./data)
# DATATALK_DATA_DIR=

# Frontend CORS
FRONTEND_ORIGIN=http://localhost:5173

# --- Modèles ouverts pour la GÉNÉRATION des requêtes SQL et MongoDB (facultatif) ---
# Si LLM_BASE_URL est définie, SQLCoder (SQL) et Qwen2.5-Coder (MongoDB) écrivent les requêtes ;
# Claude garde le classifieur, le planificateur hybride, les validateurs et la réponse finale.
# Vide : tout est généré par Claude, comme avant. Serveur : voir le README à la racine, étape 7 (GPU Google Colab).
# URL affichée par le notebook Colab ; elle CHANGE à chaque session Colab.
LLM_BASE_URL=
# Même valeur que LLM_API_KEY définie dans le notebook Colab (protège l'URL publique).
LLM_API_KEY=
LLM_MODEL_SQL=sqlcoder-7b-2
LLM_MODEL_MONGO=qwen2.5-coder-7b
LLM_MODEL_GENERAL=qwen2.5-coder-7b
LLM_TIMEOUT_S=180
# "claude" : ignore LLM_BASE_URL (pour comparer Claude et les modèles ouverts sans toucher à l'URL).
# DATATALK_GENERATOR=open
# Corrections (tentatives 2 et 3) : "open" (défaut) ou "claude" (plus fiable, mais payant).
# DATATALK_FIX_WITH=open
# Traduire la question en anglais avant la génération (modèles ouverts) ; traduire aussi les règles métier du RAG.
# DATATALK_TRANSLATE=1
# DATATALK_TRANSLATE_CONTEXT=0
# Vérification déterministe des champs d'un pipeline MongoDB (modèles ouverts).
# DATATALK_MONGO_FIELD_CHECK=1
# Embeddings du RAG : le défaut (all-MiniLM-L6-v2) est anglais ; pour des règles métier en français :
# DATATALK_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
